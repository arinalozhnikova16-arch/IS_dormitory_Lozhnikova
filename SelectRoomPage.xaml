<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Dimitrova_3_bldg_3.SelectRoomPage"
             Title="Выбор комнаты">
    <Grid RowDefinitions="*,Auto" Padding="15">
        <Grid Grid.Row="0" ColumnDefinitions="*,*" ColumnSpacing="15">
            <VerticalStackLayout Grid.Column="0">
                <Label Text="Список комнат" FontAttributes="Bold" Margin="0,0,0,5"/>

                <Picker x:Name="pickerGenderFilter" Title="Фильтр: Все" Margin="0,0,0,5" SelectedIndexChanged="OnGenderFilterChanged">
                    <Picker.Items>
                        <x:String>Все</x:String>
                        <x:String>Мужская</x:String>
                        <x:String>Женская</x:String>
                    </Picker.Items>
                </Picker>

                <CollectionView x:Name="cvRooms" SelectionMode="Single" SelectionChanged="OnRoomSelected">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border>
                                <Label Text="{Binding}" Padding="5" Margin="0,2"/>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="1">
                <Label Text="Проживающие в комнате" FontAttributes="Bold" Margin="0,0,0,5"/>
                <Border>
                    <CollectionView x:Name="cvResidents" BackgroundColor="#F0F0F0">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Label Text="{Binding}" Padding="5" Margin="0,2"/>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Border>
            </VerticalStackLayout>
        </Grid>
        <HorizontalStackLayout Grid.Row="1" Spacing="15" HorizontalOptions="End" Margin="0,10,0,0">
            <Button Text="Отмена" Clicked="OnCancelClicked" WidthRequest="100"/>
            <Button Text="Выбрать комнату" Clicked="OnSelectClicked" WidthRequest="150" BackgroundColor="DarkBlue" TextColor="White"/>
        </HorizontalStackLayout>
    </Grid>
</ContentPage>